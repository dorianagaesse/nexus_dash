generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String    @id @default(cuid())
  name                  String?
  email                 String?   @unique
  passwordHash          String?
  username              String?   @db.VarChar(20)
  usernameDiscriminator String?   @db.VarChar(4)
  avatarSeed            String?   @db.VarChar(64)
  emailVerified         DateTime?
  image                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  accounts                            Account[]
  sessions                            Session[]
  ownedProjects                       Project[]                                @relation("ProjectOwner")
  projectMemberships                  ProjectMembership[]
  projectInvitationsSent              ProjectInvitation[]                      @relation("ProjectInvitationInviter")
  taskAttachments                     TaskAttachment[]                         @relation("TaskAttachmentUploader")
  taskComments                        TaskComment[]                            @relation("TaskCommentAuthor")
  tasksCreated                        Task[]                                   @relation("TaskCreatedBy")
  tasksUpdated                        Task[]                                   @relation("TaskUpdatedBy")
  tasksAssigned                       Task[]                                   @relation("TaskAssignee")
  resourceAttachments                 ResourceAttachment[]                     @relation("ResourceAttachmentUploader")
  calendarConnections                 CalendarConnection[]
  calendarSources                     CalendarSource[]
  calendarPreference                  CalendarPreference?
  emailVerificationTokens             EmailVerificationToken[]
  passwordResetTokens                 PasswordResetToken[]
  createdApiCredentials               ApiCredential[]                          @relation("ApiCredentialCreatedBy")
  revokedApiCredentials               ApiCredential[]                          @relation("ApiCredentialRevokedBy")
  authAuditEvents                     AuthAuditEvent[]                         @relation("AuthAuditEventActorUser")
  notifications                       Notification[]                           @relation("NotificationRecipient")
  projectNotificationEmails           ProjectNotificationEmail[]               @relation("ProjectNotificationEmailRecipient")
  taskCommentReactions                TaskCommentReaction[]
  projectActivityEvents               ProjectActivityEvent[]
  projectMeetingNotesCreated          ProjectMeetingNote[]                     @relation("ProjectMeetingNoteCreatedBy")
  projectMeetingNotesUpdated          ProjectMeetingNote[]                     @relation("ProjectMeetingNoteUpdatedBy")
  projectMeetingNotesStewarded        ProjectMeetingNote[]                     @relation("ProjectMeetingNoteSteward")
  projectMeetingParticipants          ProjectMeetingNoteParticipant[]
  meetingTodoActionsCreated           ProjectMeetingNoteAction[]               @relation("MeetingTodoCreatedByUser")
  meetingTodoActionsAssigned          ProjectMeetingNoteAction[]               @relation("MeetingTodoAssignedToUser")
  meetingTodoActionsCompleted         ProjectMeetingNoteAction[]               @relation("MeetingTodoCompletedByUser")
  contextCardsCreated                 Resource[]                               @relation("ContextCardCreatedByUser")
  contextCardsLastEdited              Resource[]                               @relation("ContextCardLastEditedByUser")
  contextCardsStewarded               Resource[]                               @relation("ContextCardStewardedUser")
  tasksAssigneeProvenance             Task[]                                   @relation("TaskAssigneeAssignedByUser")
  taskAssigneeChangesPrevious         TaskAssigneeChange[]                     @relation("TaskAssigneeChangePreviousUser")
  taskAssigneeChangesNext             TaskAssigneeChange[]                     @relation("TaskAssigneeChangeNextUser")
  taskAssigneeChangesPerformed        TaskAssigneeChange[]                     @relation("TaskAssigneeChangeActorUser")
  meetingTodoActionsAssignedBy        ProjectMeetingNoteAction[]               @relation("MeetingTodoAssignedByUser")
  meetingTodoAssigneeChangesPrevious  ProjectMeetingNoteActionAssigneeChange[] @relation("MeetingTodoAssigneeChangePreviousUser")
  meetingTodoAssigneeChangesNext      ProjectMeetingNoteActionAssigneeChange[] @relation("MeetingTodoAssigneeChangeNextUser")
  meetingTodoAssigneeChangesPerformed ProjectMeetingNoteActionAssigneeChange[] @relation("MeetingTodoAssigneeChangeActorUser")
  taskCommentAgentMentions            TaskCommentAgentMention[]                @relation("TaskCommentAgentMentionCreator")

  @@unique([username, usernameDiscriminator])
  @@index([username])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  email      String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  email      String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, expiresAt])
}

enum OutboundEmailDeliveryStatus {
  pending
  sent
  skipped
  failed
}

model OutboundEmailDelivery {
  id                String                      @id @default(cuid())
  templateKey       String                      @db.VarChar(80)
  provider          String                      @db.VarChar(40)
  fromEmail         String
  recipientEmail    String
  subject           String                      @db.VarChar(240)
  status            OutboundEmailDeliveryStatus @default(pending)
  providerMessageId String?                     @db.VarChar(128)
  providerStatus    Int?
  errorCode         String?                     @db.VarChar(80)
  errorMessage      String?
  metadata          Json?
  lastAttemptAt     DateTime?
  completedAt       DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  projectNotificationEmails ProjectNotificationEmail[]

  @@index([recipientEmail, createdAt])
  @@index([templateKey, createdAt])
  @@index([status, createdAt])
  @@index([providerMessageId])
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id               String   @id @default(cuid())
  sessionTokenHash String   @unique
  userId           String
  expires          DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SystemGuard {
  id               Int      @id
  environment      String   @default("unknown")
  allowStagingWipe Boolean  @default(false) @map("allow_staging_wipe")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("system_guard")
}

enum ProjectMembershipRole {
  owner
  editor
  viewer
}

enum MeetingTodoActorKind {
  human
  agent
  participant
}

enum ContextCardActorKind {
  human
  agent
}

enum ProjectActorKind {
  human
  agent
}

enum RoadmapMilestoneStatus {
  planned
  active
  reached
}

model Project {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner              User                       @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  tasks              Task[]
  epics              Epic[]
  roadmapPhases      RoadmapPhase[]
  roadmapEvents      RoadmapEvent[]
  activityEvents     ProjectActivityEvent[]
  resources          Resource[]
  memberships        ProjectMembership[]
  invitations        ProjectInvitation[]
  taskRelations      TaskRelation[]
  apiCredentials     ApiCredential[]
  authAuditEvents    AuthAuditEvent[]
  notificationEmails ProjectNotificationEmail[]
  meetingNotes       ProjectMeetingNote[]

  @@index([ownerId])
}

model ProjectMeetingNote {
  id                         String                @id @default(cuid())
  projectId                  String
  title                      String                @db.VarChar(140)
  scheduledAt                DateTime?
  status                     String                @default("prepared") @db.VarChar(40)
  labelsJson                 String?
  inputNotes                 String                @default("")
  outputNotes                String                @default("")
  decisions                  String                @default("")
  createdByUserId            String
  updatedByUserId            String
  stewardUserId              String?
  stewardCredentialId        String?
  stewardKind                MeetingTodoActorKind?
  stewardDisplayNameSnapshot String?               @db.VarChar(80)
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt

  project           Project                         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdByUser     User                            @relation("ProjectMeetingNoteCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUser     User                            @relation("ProjectMeetingNoteUpdatedBy", fields: [updatedByUserId], references: [id])
  stewardUser       User?                           @relation("ProjectMeetingNoteSteward", fields: [stewardUserId], references: [id], onDelete: SetNull)
  stewardCredential ApiCredential?                  @relation("MeetingNoteStewardCredential", fields: [stewardCredentialId], references: [id], onDelete: SetNull)
  actions           ProjectMeetingNoteAction[]
  participants      ProjectMeetingNoteParticipant[]

  @@index([projectId, scheduledAt])
  @@index([projectId, status, scheduledAt])
  @@index([projectId, updatedAt])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@index([stewardUserId])
  @@index([stewardCredentialId])
}

model ProjectMeetingNoteParticipant {
  id            String   @id @default(cuid())
  meetingNoteId String
  userId        String?
  displayName   String
  position      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  meetingNote ProjectMeetingNote @relation(fields: [meetingNoteId], references: [id], onDelete: Cascade)
  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([meetingNoteId, position])
  @@index([meetingNoteId])
  @@index([userId])
}

model ProjectMeetingNoteAction {
  id                             String                @id @default(cuid())
  meetingNoteId                  String
  content                        String                @db.VarChar(240)
  completedAt                    DateTime?
  position                       Int                   @default(0)
  createdByUserId                String?
  createdByCredentialId          String?
  creatorKind                    MeetingTodoActorKind  @default(human)
  creatorDisplayNameSnapshot     String                @default("Unknown actor") @db.VarChar(80)
  assigneeUserId                 String?
  assigneeCredentialId           String?
  assigneeKind                   MeetingTodoActorKind?
  assigneeDisplayNameSnapshot    String?               @db.VarChar(80)
  assignedByKind                 ProjectActorKind?
  assignedByUserId               String?
  assignedByCredentialId         String?
  assignedByDisplayNameSnapshot  String?               @db.VarChar(80)
  assignedAt                     DateTime?
  completedByUserId              String?
  completedByCredentialId        String?
  completedByKind                MeetingTodoActorKind?
  completedByDisplayNameSnapshot String?               @db.VarChar(80)
  createdAt                      DateTime              @default(now())
  updatedAt                      DateTime              @updatedAt

  meetingNote           ProjectMeetingNote                       @relation(fields: [meetingNoteId], references: [id], onDelete: Cascade)
  createdByUser         User?                                    @relation("MeetingTodoCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByCredential   ApiCredential?                           @relation("MeetingTodoCreatedByCredential", fields: [createdByCredentialId], references: [id], onDelete: SetNull)
  assigneeUser          User?                                    @relation("MeetingTodoAssignedToUser", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  assigneeCredential    ApiCredential?                           @relation("MeetingTodoAssignedToCredential", fields: [assigneeCredentialId], references: [id], onDelete: SetNull)
  assignedByUser        User?                                    @relation("MeetingTodoAssignedByUser", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  assignedByCredential  ApiCredential?                           @relation("MeetingTodoAssignedByCredential", fields: [assignedByCredentialId], references: [id], onDelete: SetNull)
  assigneeChanges       ProjectMeetingNoteActionAssigneeChange[]
  completedByUser       User?                                    @relation("MeetingTodoCompletedByUser", fields: [completedByUserId], references: [id], onDelete: SetNull)
  completedByCredential ApiCredential?                           @relation("MeetingTodoCompletedByCredential", fields: [completedByCredentialId], references: [id], onDelete: SetNull)

  @@index([meetingNoteId, position])
  @@index([meetingNoteId, completedAt])
  @@index([assigneeUserId, completedAt])
  @@index([assigneeCredentialId, completedAt])
  @@index([createdByUserId])
  @@index([createdByCredentialId])
  @@index([completedByUserId])
  @@index([completedByCredentialId])
}

model ProjectMeetingNoteActionAssigneeChange {
  id                                  String                @id @default(cuid())
  actionId                            String
  previousAssigneeKind                MeetingTodoActorKind?
  previousAssigneeUserId              String?
  previousAssigneeCredentialId        String?
  previousAssigneeDisplayNameSnapshot String?               @db.VarChar(80)
  nextAssigneeKind                    MeetingTodoActorKind?
  nextAssigneeUserId                  String?
  nextAssigneeCredentialId            String?
  nextAssigneeDisplayNameSnapshot     String?               @db.VarChar(80)
  changedByKind                       ProjectActorKind
  changedByUserId                     String?
  changedByCredentialId               String?
  changedByDisplayNameSnapshot        String                @db.VarChar(80)
  createdAt                           DateTime              @default(now())

  action                     ProjectMeetingNoteAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  previousAssigneeUser       User?                    @relation("MeetingTodoAssigneeChangePreviousUser", fields: [previousAssigneeUserId], references: [id], onDelete: SetNull)
  previousAssigneeCredential ApiCredential?           @relation("MeetingTodoAssigneeChangePreviousCredential", fields: [previousAssigneeCredentialId], references: [id], onDelete: SetNull)
  nextAssigneeUser           User?                    @relation("MeetingTodoAssigneeChangeNextUser", fields: [nextAssigneeUserId], references: [id], onDelete: SetNull)
  nextAssigneeCredential     ApiCredential?           @relation("MeetingTodoAssigneeChangeNextCredential", fields: [nextAssigneeCredentialId], references: [id], onDelete: SetNull)
  changedByUser              User?                    @relation("MeetingTodoAssigneeChangeActorUser", fields: [changedByUserId], references: [id], onDelete: SetNull)
  changedByCredential        ApiCredential?           @relation("MeetingTodoAssigneeChangeActorCredential", fields: [changedByCredentialId], references: [id], onDelete: SetNull)

  @@index([actionId, createdAt])
}

model ProjectActivityEvent {
  id          String   @id @default(cuid())
  projectId   String
  actorUserId String?
  domain      String   @db.VarChar(40)
  action      String   @db.VarChar(40)
  entityId    String   @db.VarChar(128)
  version     DateTime @default(now())
  payload     Json?
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([projectId, version])
  @@index([projectId, version, createdAt, id])
  @@index([projectId, createdAt])
  @@index([domain, action])
  @@index([actorUserId])
}

model ProjectMembership {
  id        String                @id @default(cuid())
  projectId String
  userId    String
  role      ProjectMembershipRole
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectInvitation {
  id              String                @id @default(cuid())
  projectId       String
  invitedEmail    String
  invitedByUserId String
  role            ProjectMembershipRole
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  replacedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedByUser User    @relation("ProjectInvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([invitedEmail])
  @@index([invitedByUserId])
}

model Notification {
  id              String    @id @default(cuid())
  recipientUserId String
  type            String    @db.VarChar(80)
  title           String    @db.VarChar(160)
  body            String?
  targetPath      String?
  sourceType      String    @db.VarChar(80)
  sourceId        String    @db.VarChar(128)
  metadata        Json?
  readAt          DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  recipient  User                           @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  emailItems ProjectNotificationEmailItem[]

  @@unique([recipientUserId, sourceType, sourceId])
  @@index([recipientUserId, createdAt])
  @@index([recipientUserId, readAt])
  @@index([recipientUserId, resolvedAt])
  @@index([type])
}

enum ProjectNotificationEmailKind {
  project_digest
  project_invitation_reminder
}

enum ProjectNotificationEmailStatus {
  pending
  dispatching
  sent
  skipped
  failed
  superseded
}

model ProjectNotificationEmail {
  id                          String                         @id @default(cuid())
  kind                        ProjectNotificationEmailKind
  recipientUserId             String
  projectId                   String
  sourceKey                   String                         @db.VarChar(128)
  groupingKey                 String                         @db.VarChar(191)
  firstPendingNotificationAt  DateTime
  latestPendingNotificationAt DateTime
  sendAfterAt                 DateTime
  maxSendAt                   DateTime
  windowStartedAt             DateTime
  windowEndedAt               DateTime
  latestNotificationAt        DateTime
  notificationCount           Int
  status                      ProjectNotificationEmailStatus @default(pending)
  claimToken                  String?                        @db.VarChar(64)
  claimedAt                   DateTime?
  attemptCount                Int                            @default(0)
  lastAttemptAt               DateTime?
  outboundEmailDeliveryId     String?
  errorCode                   String?                        @db.VarChar(80)
  metadata                    Json?
  completedAt                 DateTime?
  createdAt                   DateTime                       @default(now())
  updatedAt                   DateTime                       @updatedAt

  recipient             User                           @relation("ProjectNotificationEmailRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  project               Project                        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  outboundEmailDelivery OutboundEmailDelivery?         @relation(fields: [outboundEmailDeliveryId], references: [id], onDelete: SetNull)
  items                 ProjectNotificationEmailItem[]

  @@unique([kind, recipientUserId, projectId, sourceKey])
  @@index([recipientUserId, projectId, createdAt])
  @@index([kind, status, sendAfterAt])
  @@index([groupingKey, status])
  @@index([outboundEmailDeliveryId])
}

model ProjectNotificationEmailItem {
  id                    String    @id @default(cuid())
  emailId               String
  notificationId        String
  notificationUpdatedAt DateTime?
  sourceFingerprint     String?   @db.VarChar(160)
  createdAt             DateTime  @default(now())

  email        ProjectNotificationEmail @relation(fields: [emailId], references: [id], onDelete: Cascade)
  notification Notification             @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([emailId, notificationId])
  @@index([notificationId])
  @@index([sourceFingerprint])
}

model Epic {
  id          String   @id @default(cuid())
  projectId   String
  name        String   @db.VarChar(80)
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, updatedAt])
}

model RoadmapPhase {
  id          String                 @id @default(cuid())
  projectId   String
  title       String                 @db.VarChar(100)
  description String?
  targetDate  DateTime?              @db.Date
  status      RoadmapMilestoneStatus @default(planned)
  position    Int                    @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events  RoadmapEvent[]

  @@unique([id, projectId])
  @@index([projectId])
  @@index([projectId, position])
  @@index([projectId, targetDate])
}

model RoadmapEvent {
  id          String                 @id @default(cuid())
  projectId   String
  phaseId     String
  title       String                 @db.VarChar(100)
  description String?
  targetDate  DateTime?              @db.Date
  status      RoadmapMilestoneStatus @default(planned)
  position    Int                    @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase   RoadmapPhase @relation(fields: [phaseId, projectId], references: [id, projectId], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, targetDate])
  @@index([phaseId])
  @@index([phaseId, position])
}

model Task {
  id                                    String                    @id @default(cuid())
  referenceNumber                       Int                       @unique @default(autoincrement())
  title                                 String
  description                           String?
  blockedNote                           String?
  deadlineAt                            DateTime?                 @db.Date
  completedAt                           DateTime?
  archivedAt                            DateTime?
  status                                String                    @default("Backlog")
  position                              Int                       @default(0)
  label                                 String?
  labelsJson                            String?
  projectId                             String
  epicId                                String?
  createdByUserId                       String
  updatedByUserId                       String
  createdByCredentialId                 String?
  createdByCredentialLabel              String?                   @db.VarChar(80)
  updatedByCredentialId                 String?
  updatedByCredentialLabel              String?                   @db.VarChar(80)
  assigneeUserId                        String?
  assigneeKind                          ProjectActorKind?
  assigneeCredentialId                  String?
  assigneeDisplayNameSnapshot           String?                   @db.VarChar(80)
  assigneeAssignedByKind                ProjectActorKind?
  assigneeAssignedByUserId              String?
  assigneeAssignedByCredentialId        String?
  assigneeAssignedByDisplayNameSnapshot String?                   @db.VarChar(80)
  assigneeAssignedAt                    DateTime?
  project                               Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  epic                                  Epic?                     @relation(fields: [epicId], references: [id], onDelete: SetNull)
  createdByUser                         User                      @relation("TaskCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUser                         User                      @relation("TaskUpdatedBy", fields: [updatedByUserId], references: [id])
  createdByCredential                   ApiCredential?            @relation("TaskCreatedByCredential", fields: [createdByCredentialId], references: [id], onDelete: SetNull)
  updatedByCredential                   ApiCredential?            @relation("TaskUpdatedByCredential", fields: [updatedByCredentialId], references: [id], onDelete: SetNull)
  assigneeUser                          User?                     @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  assigneeCredential                    ApiCredential?            @relation("TaskAssignedToCredential", fields: [assigneeCredentialId], references: [id], onDelete: SetNull)
  assigneeAssignedByUser                User?                     @relation("TaskAssigneeAssignedByUser", fields: [assigneeAssignedByUserId], references: [id], onDelete: SetNull)
  assigneeAssignedByCredential          ApiCredential?            @relation("TaskAssigneeAssignedByCredential", fields: [assigneeAssignedByCredentialId], references: [id], onDelete: SetNull)
  assigneeChanges                       TaskAssigneeChange[]
  attachments                           TaskAttachment[]
  comments                              TaskComment[]
  agentMentions                         TaskCommentAgentMention[]
  blockedFollowUps                      TaskBlockedFollowUp[]
  outgoingRelations                     TaskRelation[]            @relation("TaskRelationLeft")
  incomingRelations                     TaskRelation[]            @relation("TaskRelationRight")
  createdAt                             DateTime                  @default(now())
  updatedAt                             DateTime                  @updatedAt

  @@index([projectId])
  @@index([projectId, deadlineAt])
  @@index([epicId])
  @@index([projectId, epicId])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@index([createdByCredentialId])
  @@index([updatedByCredentialId])
  @@index([assigneeUserId])
  @@index([projectId, assigneeUserId])
  @@index([assigneeCredentialId])
  @@index([projectId, assigneeCredentialId])
}

model TaskComment {
  id                         String         @id @default(cuid())
  taskId                     String
  authorUserId               String
  authorAgentCredentialId    String?
  authorAgentCredentialLabel String?        @db.VarChar(80)
  task                       Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author                     User           @relation("TaskCommentAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  authorAgentCredential      ApiCredential? @relation("TaskCommentAgentAuthorCredential", fields: [authorAgentCredentialId], references: [id], onDelete: SetNull)
  content                    String
  createdAt                  DateTime       @default(now())

  reactions     TaskCommentReaction[]
  agentMentions TaskCommentAgentMention[]

  @@index([taskId, createdAt])
  @@index([authorUserId])
  @@index([authorAgentCredentialId])
}

model TaskCommentAgentMention {
  id                       String   @id @default(cuid())
  commentId                String
  taskId                   String
  agentCredentialId        String?
  agentLabel               String   @db.VarChar(80)
  createdByUserId          String
  createdByCredentialId    String?
  createdByCredentialLabel String?  @db.VarChar(80)
  createdAt                DateTime @default(now())

  comment             TaskComment    @relation(fields: [commentId], references: [id], onDelete: Cascade)
  task                Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agentCredential     ApiCredential? @relation("TaskCommentAgentMentionCredential", fields: [agentCredentialId], references: [id], onDelete: SetNull)
  createdByUser       User           @relation("TaskCommentAgentMentionCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdByCredential ApiCredential? @relation("TaskCommentAgentMentionCreatorCredential", fields: [createdByCredentialId], references: [id], onDelete: SetNull)

  @@unique([commentId, agentCredentialId])
  @@index([taskId, createdAt])
  @@index([agentCredentialId])
  @@index([createdByUserId])
  @@index([createdByCredentialId])
}

model TaskCommentReaction {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  comment TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@index([commentId])
  @@index([userId])
}

model TaskRelation {
  leftTaskId  String
  rightTaskId String
  projectId   String
  createdAt   DateTime @default(now())

  leftTask  Task    @relation("TaskRelationLeft", fields: [leftTaskId], references: [id], onDelete: Cascade)
  rightTask Task    @relation("TaskRelationRight", fields: [rightTaskId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([leftTaskId, rightTaskId])
  @@index([projectId])
  @@index([rightTaskId])
}

model Resource {
  id                            String                @id @default(cuid())
  type                          String
  name                          String
  content                       String
  color                         String?
  projectId                     String
  project                       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attachments                   ResourceAttachment[]
  createdByUserId               String?
  createdByCredentialId         String?
  creatorKind                   ContextCardActorKind  @default(human)
  creatorDisplayNameSnapshot    String                @default("Unknown actor") @db.VarChar(80)
  lastEditedByUserId            String?
  lastEditedByCredentialId      String?
  lastEditorKind                ContextCardActorKind?
  lastEditorDisplayNameSnapshot String?               @db.VarChar(80)
  stewardUserId                 String?
  stewardCredentialId           String?
  stewardKind                   ContextCardActorKind?
  stewardDisplayNameSnapshot    String?               @db.VarChar(80)
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime              @updatedAt

  createdByUser          User?          @relation("ContextCardCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByCredential    ApiCredential? @relation("ContextCardCreatedByCredential", fields: [createdByCredentialId], references: [id], onDelete: SetNull)
  lastEditedByUser       User?          @relation("ContextCardLastEditedByUser", fields: [lastEditedByUserId], references: [id], onDelete: SetNull)
  lastEditedByCredential ApiCredential? @relation("ContextCardLastEditedByCredential", fields: [lastEditedByCredentialId], references: [id], onDelete: SetNull)
  stewardUser            User?          @relation("ContextCardStewardedUser", fields: [stewardUserId], references: [id], onDelete: SetNull)
  stewardCredential      ApiCredential? @relation("ContextCardStewardedCredential", fields: [stewardCredentialId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([createdByUserId])
  @@index([createdByCredentialId])
  @@index([lastEditedByUserId])
  @@index([lastEditedByCredentialId])
  @@index([stewardUserId])
  @@index([stewardCredentialId])
  @@index([projectId, updatedAt])
}

model TaskAttachment {
  id               String   @id @default(cuid())
  taskId           String
  uploadedByUserId String
  task             Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy       User     @relation("TaskAttachmentUploader", fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  kind             String
  name             String
  url              String?
  storageKey       String?
  mimeType         String?
  sizeBytes        Int?
  createdAt        DateTime @default(now())

  @@index([taskId])
  @@index([uploadedByUserId])
}

model ResourceAttachment {
  id                            String               @id @default(cuid())
  resourceId                    String
  uploadedByUserId              String
  uploadedByKind                ContextCardActorKind @default(human)
  uploadedByDisplayNameSnapshot String               @default("Unknown uploader") @db.VarChar(80)
  resource                      Resource             @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  uploadedBy                    User                 @relation("ResourceAttachmentUploader", fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  kind                          String
  name                          String
  url                           String?
  storageKey                    String?
  mimeType                      String?
  sizeBytes                     Int?
  createdAt                     DateTime             @default(now())

  @@index([resourceId])
  @@index([uploadedByUserId])
}

model TaskBlockedFollowUp {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

model TaskAssigneeChange {
  id                                  String            @id @default(cuid())
  taskId                              String
  previousAssigneeKind                ProjectActorKind?
  previousAssigneeUserId              String?
  previousAssigneeCredentialId        String?
  previousAssigneeDisplayNameSnapshot String?           @db.VarChar(80)
  nextAssigneeKind                    ProjectActorKind?
  nextAssigneeUserId                  String?
  nextAssigneeCredentialId            String?
  nextAssigneeDisplayNameSnapshot     String?           @db.VarChar(80)
  changedByKind                       ProjectActorKind
  changedByUserId                     String?
  changedByCredentialId               String?
  changedByDisplayNameSnapshot        String            @db.VarChar(80)
  createdAt                           DateTime          @default(now())

  task                       Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  previousAssigneeUser       User?          @relation("TaskAssigneeChangePreviousUser", fields: [previousAssigneeUserId], references: [id], onDelete: SetNull)
  previousAssigneeCredential ApiCredential? @relation("TaskAssigneeChangePreviousCredential", fields: [previousAssigneeCredentialId], references: [id], onDelete: SetNull)
  nextAssigneeUser           User?          @relation("TaskAssigneeChangeNextUser", fields: [nextAssigneeUserId], references: [id], onDelete: SetNull)
  nextAssigneeCredential     ApiCredential? @relation("TaskAssigneeChangeNextCredential", fields: [nextAssigneeCredentialId], references: [id], onDelete: SetNull)
  changedByUser              User?          @relation("TaskAssigneeChangeActorUser", fields: [changedByUserId], references: [id], onDelete: SetNull)
  changedByCredential        ApiCredential? @relation("TaskAssigneeChangeActorCredential", fields: [changedByCredentialId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

model CalendarConnection {
  id                        String    @id @default(cuid())
  userId                    String
  provider                  String    @db.VarChar(32)
  providerAccountId         String    @db.VarChar(255)
  accountEmail              String?
  accountLabel              String
  accessToken               String?
  refreshToken              String
  tokenType                 String?
  scopes                    String?
  expiresAt                 DateTime?
  revokedAt                 DateTime?
  reauthorizationRequiredAt DateTime?
  calendarListSyncedAt      DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources            CalendarSource[]     @relation("CalendarConnectionSources")
  defaultPreferences CalendarPreference[] @relation("DefaultCalendarConnection")

  @@unique([userId, provider, providerAccountId])
  @@unique([id, userId])
  @@index([userId, revokedAt])
}

model CalendarSource {
  id                 String   @id @default(cuid())
  userId             String
  connectionId       String
  providerCalendarId String
  name               String
  color              String?
  timeZone           String?
  accessRole         String?
  isPrimary          Boolean  @default(false)
  isAvailable        Boolean  @default(true)
  isSelected         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection       CalendarConnection   @relation("CalendarConnectionSources", fields: [connectionId, userId], references: [id, userId], onDelete: Cascade)
  writePreferences CalendarPreference[] @relation("WriteCalendarSource")

  @@unique([connectionId, providerCalendarId])
  @@unique([id, userId])
  @@index([userId, isSelected])
  @@index([connectionId, isAvailable])
}

model CalendarPreference {
  userId              String   @id
  defaultConnectionId String?
  writeSourceId       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultConnection CalendarConnection? @relation("DefaultCalendarConnection", fields: [defaultConnectionId, userId], references: [id, userId], onDelete: Restrict)
  writeSource       CalendarSource?     @relation("WriteCalendarSource", fields: [writeSourceId, userId], references: [id, userId], onDelete: Restrict)

  @@index([defaultConnectionId])
  @@index([writeSourceId])
}

enum ApiCredentialScope {
  project_read
  task_read
  task_write
  task_delete
  context_read
  context_write
  context_delete
  roadmap_read
  roadmap_write
  roadmap_delete
}

enum AuthAuditActorKind {
  human
  agent
}

enum AuthAuditAction {
  credential_created
  credential_rotated
  credential_revoked
  token_exchanged
  token_exchange_failed
  request_used
}

enum AuthRateLimitScope {
  sign_in
  sign_up
  password_reset
  verification_resend
  agent_token_exchange
}

model ApiCredential {
  id              String    @id @default(cuid())
  projectId       String
  createdByUserId String
  revokedByUserId String?
  label           String    @db.VarChar(80)
  publicId        String    @unique @db.VarChar(64)
  secretHash      String
  expiresAt       DateTime?
  lastUsedAt      DateTime?
  lastExchangedAt DateTime?
  lastRotatedAt   DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project                             Project                                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdByUser                       User                                     @relation("ApiCredentialCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  revokedByUser                       User?                                    @relation("ApiCredentialRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  scopeGrants                         ApiCredentialScopeGrant[]
  auditEvents                         AuthAuditEvent[]
  taskComments                        TaskComment[]                            @relation("TaskCommentAgentAuthorCredential")
  taskCommentAgentMentions            TaskCommentAgentMention[]                @relation("TaskCommentAgentMentionCredential")
  taskCommentAgentMentionsBy          TaskCommentAgentMention[]                @relation("TaskCommentAgentMentionCreatorCredential")
  tasksCreated                        Task[]                                   @relation("TaskCreatedByCredential")
  tasksUpdated                        Task[]                                   @relation("TaskUpdatedByCredential")
  meetingTodoActionsCreated           ProjectMeetingNoteAction[]               @relation("MeetingTodoCreatedByCredential")
  meetingTodoActionsAssigned          ProjectMeetingNoteAction[]               @relation("MeetingTodoAssignedToCredential")
  meetingTodoActionsCompleted         ProjectMeetingNoteAction[]               @relation("MeetingTodoCompletedByCredential")
  contextCardsCreated                 Resource[]                               @relation("ContextCardCreatedByCredential")
  contextCardsLastEdited              Resource[]                               @relation("ContextCardLastEditedByCredential")
  contextCardsStewarded               Resource[]                               @relation("ContextCardStewardedCredential")
  meetingNotesStewarded               ProjectMeetingNote[]                     @relation("MeetingNoteStewardCredential")
  tasksAssignedToCredential           Task[]                                   @relation("TaskAssignedToCredential")
  tasksAssigneeProvenance             Task[]                                   @relation("TaskAssigneeAssignedByCredential")
  taskAssigneeChangesPrevious         TaskAssigneeChange[]                     @relation("TaskAssigneeChangePreviousCredential")
  taskAssigneeChangesNext             TaskAssigneeChange[]                     @relation("TaskAssigneeChangeNextCredential")
  taskAssigneeChangesPerformed        TaskAssigneeChange[]                     @relation("TaskAssigneeChangeActorCredential")
  meetingTodoActionsAssignedBy        ProjectMeetingNoteAction[]               @relation("MeetingTodoAssignedByCredential")
  meetingTodoAssigneeChangesPrevious  ProjectMeetingNoteActionAssigneeChange[] @relation("MeetingTodoAssigneeChangePreviousCredential")
  meetingTodoAssigneeChangesNext      ProjectMeetingNoteActionAssigneeChange[] @relation("MeetingTodoAssigneeChangeNextCredential")
  meetingTodoAssigneeChangesPerformed ProjectMeetingNoteActionAssigneeChange[] @relation("MeetingTodoAssigneeChangeActorCredential")

  @@index([projectId])
  @@index([createdByUserId])
  @@index([revokedByUserId])
}

model ApiCredentialScopeGrant {
  credentialId String
  scope        ApiCredentialScope
  createdAt    DateTime           @default(now())

  credential ApiCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@id([credentialId, scope])
  @@index([scope])
}

model AuthAuditEvent {
  id           String             @id @default(cuid())
  projectId    String
  credentialId String?
  actorUserId  String?
  actorKind    AuthAuditActorKind
  action       AuthAuditAction
  requestId    String?            @db.VarChar(128)
  ipAddress    String?            @db.VarChar(64)
  userAgent    String?            @db.VarChar(512)
  metadata     Json?
  createdAt    DateTime           @default(now())

  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  credential ApiCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  actorUser  User?          @relation("AuthAuditEventActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([credentialId, createdAt])
  @@index([actorUserId, createdAt])
}

model AuthRateLimitBucket {
  scope        AuthRateLimitScope
  key          String             @db.VarChar(191)
  windowStart  DateTime           @db.Timestamptz(6)
  attemptCount Int                @default(0)
  blockedUntil DateTime?          @db.Timestamptz(6)
  createdAt    DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(6)

  @@id([scope, key, windowStart])
  @@index([scope, key, blockedUntil])
  @@index([createdAt])
}
