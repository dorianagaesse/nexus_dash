# NexusDash agent credentials template (safe to commit).
#
# Copy this file to .config/.nd-nexus-dash.env and fill in real values.
# The real file is gitignored via /.config/ — never commit it.

# Base URL of the NexusDash instance.
NEXUSDASH_BASE_URL=https://nexus-dash.app

# Target project id (from NexusDash project settings).
NEXUSDASH_PROJECT_ID=<paste-project-id>

# One-time raw API key for the project-scoped agent credential.
NEXUSDASH_API_KEY=<paste-one-time-api-key>

# Agent token exchange endpoint (relative to NEXUSDASH_BASE_URL).
NEXUSDASH_AGENT_TOKEN_PATH=/api/auth/agent/token

# Short-lived bearer token obtained by exchanging the API key at runtime.
NEXUSDASH_AGENT_BEARER_TOKEN=<exchange-at-runtime>

# Hosted agent docs and OpenAPI contract.
NEXUSDASH_AGENT_DOCS_URL=https://nexus-dash.app/docs/agent/v1
NEXUSDASH_AGENT_OPENAPI_URL=https://nexus-dash.app/api/docs/agent/v1/openapi.json
