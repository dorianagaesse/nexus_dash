{
  "name": "nexusdash",
  "version": "0.73.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run db:migrate && next dev",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "npm run db:migrate && next start",
    "lint": "eslint .",
    "rls:check": "node scripts/check-rls-inventory.mjs",
    "test:rls:setup": "node scripts/setup-rls-test-role.mjs",
    "test:rls:realtime-stub": "node scripts/setup-realtime-rls-stub.mjs",
    "test:rls": "node scripts/test-rls-isolation.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:audit:full": "npm audit --json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "worktree:create": "node create-worktree.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:backfill-username-tags": "node scripts/backfill-username-tags.mjs",
    "db:local:up": "docker compose up -d --wait postgres",
    "db:local:down": "docker compose stop postgres",
    "db:local:reset": "node scripts/local-db-reset.mjs",
    "release:version": "node scripts/release-version.mjs",
    "release:check": "node scripts/check-version-policy.mjs",
    "validate:local": "node scripts/local-validation.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/s3-request-presigner": "^3.1154.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/supabase-js": "2.109.0",
    "@types/pg": "^8.23.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "emojibase-data": "^18.0.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "^2.18.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "ws": "^8.22.0"
  },
  "overrides": {
    "ajv": "6.14.0",
    "flatted": "3.4.2",
    "brace-expansion@^1.1.0": "1.1.21",
    "brace-expansion@^2.0.0": "2.0.3",
    "brace-expansion@^5.0.0": "5.0.12",
    "js-yaml@^4.0.0": "4.3.2",
    "minimatch@^3.0.0": "3.1.5",
    "minimatch@^9.0.0": "9.0.9",
    "undici@^7.0.0": "7.30.1",
    "vite@^8.0.0": "8.3.5",
    "zod@^4.0.0": "4.6.7",
    "picomatch@^2.0.0": "2.3.2",
    "picomatch@^4.0.0": "4.0.4",
    "next": {
      "postcss": "8.5.31"
    }
  }
}
